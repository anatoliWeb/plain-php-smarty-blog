# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

# Local environment name.
APP_ENV=local

# Enable detailed errors during local development.
APP_DEBUG=true

# Host port for the web application.
# Change this value if the port is already used by another project.
APP_HOST_PORT=8080


# ------------------------------------------------------------
# Database connection used by PHP inside Docker
# ------------------------------------------------------------

# Docker service name for MySQL.
# Keep this value as "mysql" when running the app through Docker.
DB_HOST=mysql

# Internal MySQL port inside Docker network.
# Usually this should stay 3306.
DB_PORT=3306

# Database name and user credentials.
DB_DATABASE=blog
DB_USERNAME=blog_user
DB_PASSWORD=blog_password


# ------------------------------------------------------------
# Database access from host machine
# ------------------------------------------------------------

# Host port for connecting to MySQL from tools like DBeaver,
# HeidiSQL, TablePlus or PhpStorm.
#
# Example:
#   Host: localhost
#   Port: 3307
#   User: blog_user
#   Password: blog_password
DB_HOST_PORT=3307

# Root password for the MySQL container.
DB_ROOT_PASSWORD=root_password